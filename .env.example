# 数据库配置
DATABASE_URL=sqlite:///var/lib/track-system/track-system.db?mode=rwc

# Gitee API Token
GITEE_TOKEN=

# GitHub API Token
GITHUB_TOKEN=

# AtomGit API Token
ATOMGIT_TOKEN=

# 日志级别
RUST_LOG=info,track_system=debug

# 服务器配置
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# AI 智能分析配置
# 默认关闭远端 AI。关闭或未配置 API Key 时，后端会使用本地启发式分析兜底。
AI_ANALYSIS_ENABLED=false
# 当前实现使用 OpenAI-compatible Chat Completions 接口。
AI_PROVIDER=openai-compatible
# OpenAI 示例: https://api.openai.com/v1
# DeepSeek 示例: https://api.deepseek.com
AI_BASE_URL=https://api.deepseek.com
# 远端模型 API Key。也可使用 OPENAI_API_KEY 作为兼容变量。
AI_API_KEY=
# DeepSeek 示例: deepseek-v4-flash / deepseek-v4-pro
# OpenAI 示例: gpt-4o-mini
AI_MODEL=deepseek-v4-flash
# AI 请求超时时间（秒）
AI_TIMEOUT_SECS=60
# 发送给模型的证据 JSON 最大字符数，超过会截断。
AI_MAX_INPUT_CHARS=16000

#risk_client配置
RISK_CREATE_ENABLED=false

# ecosystem 抓取超时配置（秒）
# 通用生态目标抓取超时
ECOSYSTEM_FETCH_TIMEOUT_SECS=60
# GitHub 平台抓取超时
ECOSYSTEM_GITHUB_FETCH_TIMEOUT_SECS=90
# openEuler 社区抓取超时
ECOSYSTEM_OPENEULER_FETCH_TIMEOUT_SECS=45

# generic_git 本地 bare mirror 缓存目录
# 默认: ${XDG_CACHE_HOME:-~/.cache}/track-system/generic-git-mirrors
TRACK_SYSTEM_GENERIC_GIT_CACHE_DIR=/var/cache/track-system/generic-git-mirrors
# 是否保留 generic_git bare mirror 缓存
# 默认: false。关闭时每次采集/预热结束后会清理缓存仓库，仅保留本次轻量 fetch 的使用效果。
TRACK_SYSTEM_GENERIC_GIT_CACHE_RETENTION_ENABLED=false
# generic_git fetch 总超时（秒）
TRACK_SYSTEM_GENERIC_GIT_FETCH_TIMEOUT_SECS=600
# generic_git 默认分支探测超时 = connect + io（秒）
TRACK_SYSTEM_GENERIC_GIT_CONNECT_TIMEOUT_SECS=15
TRACK_SYSTEM_GENERIC_GIT_IO_TIMEOUT_SECS=60

TRACK_TIMEOUT=30

TRACK_REPORT_ARTIFACT_DIR=''
TRACK_XLSX_SYSTEM_VERSION_BLACKLIST=CTyunOS2.0.1,CTyunOS25.05

# xlsx 报告邮件发送配置
# 默认关闭。开启后，调度轮次生成 CVE/ISSUE 漏洞修复对比 xlsx 后会通过 SMTP 发送附件。
TRACK_MAIL_ENABLED=false
TRACK_MAIL_SMTP_HOST=smtp.example.com
TRACK_MAIL_SMTP_PORT=465
# 支持 starttls / wrapper / none。587 通常使用 starttls，465 通常使用 wrapper。
TRACK_MAIL_SMTP_TLS=wrapper
TRACK_MAIL_SMTP_USERNAME=
# 推荐使用加密密码配置。密文为 base64(nonce[12] + AES-256-GCM(ciphertext+tag))。
TRACK_MAIL_SMTP_PASSWORD_ENCRYPTED=
# 密钥文件内容为 base64 编码的 32 字节 AES-256-GCM 密钥，建议权限 600。
TRACK_MAIL_SMTP_PASSWORD_KEY_FILE=/etc/track-system/track-mail-smtp-password.key
# 兼容旧配置，不推荐使用明文密码。
# TRACK_MAIL_SMTP_PASSWORD=
TRACK_MAIL_FROM=track-system@example.com
TRACK_MAIL_TO=receiver1@example.com,receiver2@example.com
TRACK_MAIL_CC=
TRACK_MAIL_SUBJECT=Track-System CVE/ISSUE 对比报告
TRACK_MAIL_TIMEOUT_SECS=60
# 是否在邮件正文中嵌入 xlsx 内容预览。附件始终保留完整 xlsx。
TRACK_MAIL_EMBED_XLSX_PREVIEW=true
# 邮件正文最多展示多少行 xlsx 数据，超过部分请查看附件。
TRACK_MAIL_EMBED_XLSX_MAX_ROWS=30
